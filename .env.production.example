# ===================================
# AgriSense Production Environment Variables
# ===================================
# Copy this file to .env for production deployment
# IMPORTANT: Change all default passwords and secrets!

# ===================================
# Application Settings
# ===================================
ENVIRONMENT=production
DEBUG=False

# ===================================
# Database Configuration (PostgreSQL)
# ===================================
POSTGRES_USER=agrisense_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
POSTGRES_DB=agrisense

# ===================================
# Authentication & Security
# ===================================
# Generate a secure secret key using: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_SECURE_SECRET_KEY

# ===================================
# Weather API (OpenWeatherMap)
# ===================================
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ===================================
# ML Service Configuration
# ===================================
# Set to False when you have a real ML model deployed
USE_MOCK_ML=True

# If using real ML service:
# ML_SERVICE_URL=http://ml-service:8001/predict

# If using Roboflow API (backup):
# ROBOFLOW_API_KEY=your_roboflow_api_key_here
# ROBOFLOW_MODEL_ID=your_model_id
# ROBOFLOW_VERSION=1

# ===================================
# CORS Configuration
# ===================================
# Add your frontend URLs (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===================================
# Logging
# ===================================
LOG_LEVEL=INFO

# ===================================
# INSTRUCTIONS
# ===================================
# 1. Copy this file: cp .env.production.example .env
# 2. Edit .env and replace all placeholder values
# 3. Generate SECRET_KEY: openssl rand -hex 32
# 4. Set strong POSTGRES_PASSWORD
# 5. Add your OPENWEATHER_API_KEY
# 6. Update CORS_ORIGINS with your domain
# 7. Never commit .env to Git!
