# ===================================
# AgriSense Environment Variables (Docker Compose)
# ===================================
# Copy this file to .env and fill in your actual values
# This file is used by docker-compose.yml

# ===================================
# Application Settings
# ===================================
ENVIRONMENT=development
DEBUG=True

# ===================================
# Database Configuration (PostgreSQL)
# ===================================
POSTGRES_USER=agrisense_user
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=agrisense

# ===================================
# Authentication & Security
# ===================================
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production
# JWT token expiry (days)
ACCESS_TOKEN_EXPIRE_DAYS=7

# ===================================
# AI Service (OpenRouter)
# ===================================
# Get your free API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ===================================
# Weather API (WeatherAPI.com)
# ===================================
# Get your free API key from: https://www.weatherapi.com/my/
WEATHERAPI_KEY=your_weatherapi_key_here

# ===================================
# ML Service Configuration
# ===================================
# Set to False when you have a real ML model deployed
USE_MOCK_ML=True

# If using real ML service:
# ML_SERVICE_URL=http://ml-service:8001/predict

# ===================================
# CORS Configuration
# ===================================
# Allowed origins for API calls (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ===================================
# Logging
# ===================================
LOG_LEVEL=DEBUG
